{
  "name": "deepcove-docs",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "build": "astro build",
    "format": "prettier --write astro.config.mjs package.json wrangler.jsonc src",
    "format:check": "prettier --check astro.config.mjs package.json wrangler.jsonc src"
  },
  "prettier": {
    "singleQuote": true,
    "printWidth": 100
  },
  "devDependencies": {
    "@astrojs/starlight": "0.43.1",
    "astro": "7.4.13",
    "prettier": "3.9.6",
    "starlight-llms-txt": "0.12.0"
  }
}
